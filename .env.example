# Copy to .env for local development. Never commit .env.
# Production and preview values are set in Vercel: Project → Settings → Environment Variables.
# Only variables starting with PUBLIC_ reach the browser. Everything else stays on the server.

# Clerk — sign-in (story 6.1)
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres — progress, quiz results, request status (story 6.2)
DATABASE_URL=

# PostHog — analytics (story 6.6)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# GitHub — term requests and issue reports create issues (stories 8.1 and 8.2)
GITHUB_TOKEN=

# Set by Vercel automatically; listed here so you know where the site URL comes from.
# VERCEL_PROJECT_PRODUCTION_URL=

# Keystatic — content editor (stories 2.1 and 2.5). See docs/keystatic-github-mode.md.
# local (default): /keystatic on the dev server saves files on disk.
# github: /keystatic also runs in production and saves edits as commits to the repo.
KEYSTATIC_STORAGE=local
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
