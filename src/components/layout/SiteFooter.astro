---
import Disclaimer from '../../features/terms/Disclaimer.astro';
import { FOOTER_NAV } from './nav';
---

<footer class="border-line bg-surface-sunken mt-16 border-t">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8">
    <p class="text-title-sm m-0">LearnInsurance · US insurance, in plain English</p>
    <Disclaimer variant="footer" />
    <nav aria-label="Footer">
      <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
        {FOOTER_NAV.map((item) => (
          <li>
            <a href={item.href} class="text-label" data-action={item.action}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<script>
  import { OPEN_SETTINGS_EVENT } from '../../lib/consent';

  // "Cookie settings" reopens the cookie banner instead of following the link.
  document.querySelectorAll('a[data-action="cookie-settings"]').forEach((link) =>
    link.addEventListener('click', (e) => {
      e.preventDefault();
      window.dispatchEvent(new Event(OPEN_SETTINGS_EVENT));
    }),
  );
</script>
