---
import type { Diagram } from '../../../content/schema/term';
import Box from './Box.astro';

type Props = Extract<Diagram, { discriminant: 'split' }>['value'];
const { left, right } = Astro.props;
---

<div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
  <Box label={left.label} lines={left.lines} />
  <span class="text-label text-center">vs</span>
  <Box label={right.label} lines={right.lines} />
</div>
