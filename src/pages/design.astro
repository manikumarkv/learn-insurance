---
import SiteLayout from '../layouts/SiteLayout.astro';
import type { Diagram } from '../content/schema/term';
import TermVisual from '../features/terms/visuals/TermVisual.astro';

const diagrams: { caption: string; diagram: Diagram }[] = [
  {
    caption: 'A $5,000 claim with a $1,000 deductible.',
    diagram: {
      discriminant: 'who-pays',
      value: {
        total: 5000,
        parts: [
          { label: 'Your deductible', amount: 1000, paidBy: 'you' },
          { label: 'Insurer pays', amount: 4000, paidBy: 'insurer' },
        ],
      },
    },
  },
  {
    caption: 'A 90-day waiting period before disability benefits start.',
    diagram: {
      discriminant: 'timeline',
      value: {
        start: 'Day 1: you become disabled',
        end: 'Day 365',
        segments: [
          { label: 'Waiting period (90 days)', share: 25, paidBy: 'you' },
          { label: 'Benefits paid', share: 75, paidBy: 'insurer' },
        ],
      },
    },
  },
  {
    caption: 'Same policy, updated. No new policy is bought.',
    diagram: {
      discriminant: 'before-after',
      value: {
        before: { label: 'Policy · Jan 1', lines: ['$100/month', 'Old address', 'Liability only'] },
        change: 'Endorsement',
        after: {
          label: 'Policy · Jan 20',
          lines: ['$120/month', 'New address', 'Liability + collision'],
        },
      },
    },
  },
  {
    caption: 'Who the coverage protects.',
    diagram: {
      discriminant: 'split',
      value: {
        left: { label: 'First-party', lines: ['Covers you', 'Your car, your home'] },
        right: {
          label: 'Third-party',
          lines: ['Covers others you harm', 'Their injuries, their property'],
        },
      },
    },
  },
  {
    caption: 'Underwriting happens before the policy is bound.',
    diagram: { discriminant: 'flow', value: { highlight: ['Underwriting'] } },
  },
];
import { Badge, Button, Card, Checkbox, Icon, ICON_NAMES, Input, Switch } from '../components/ui';
---

<SiteLayout
  title="Design system · LearnInsurance"
  description="Paper Design components used on LearnInsurance."
  noindex
>
  <div class="flex max-w-3xl flex-col gap-8">
    <div>
      <h1 class="text-headline m-0">Paper Design</h1>
      <p class="text-body-sm text-ink-muted m-0">
        Ink on paper. No colour, no shadows, no motion. Switch themes with the picker in the header.
      </p>
    </div>

    <section aria-labelledby="buttons" class="flex flex-col gap-3">
      <h2 id="buttons" class="text-title-lg m-0">
        Buttons
      </h2>
      <div class="flex flex-wrap items-center gap-3">
        <Button variant="primary">Start learning</Button>
        <Button>Save term</Button>
        <Button variant="ghost">Skip</Button>
        <Button icon="search" aria-label="Search" />
        <Button size="sm" iconRight="arrow-right">
          Next
        </Button>
        <Button disabled>Disabled</Button>
      </div>
    </section>

    <section aria-labelledby="badges" class="flex flex-col gap-3">
      <h2 id="badges" class="text-title-lg m-0">
        Badges
      </h2>
      <div class="flex flex-wrap items-center gap-2">
        <Badge>Medium usage</Badge>
        <Badge tone="solid" icon="check">
          Answered
        </Badge>
        <Badge tone="muted">Beginner</Badge>
        <Badge icon="info">AI-generated · AI-reviewed</Badge>
      </div>
    </section>

    <section aria-labelledby="forms" class="flex flex-col gap-3">
      <h2 id="forms" class="text-title-lg m-0">
        Form controls
      </h2>
      <div class="flex max-w-sm flex-col gap-4">
        <Input
          label="Search terms"
          placeholder="e.g. deductible"
          hint="Try a word from your policy."
        />
        <Input label="Term name" defaultValue="Endorsment" error="Check the spelling." />
        <Checkbox label="Include abbreviations" defaultChecked />
        <Switch label="Show quick answers" defaultChecked />
      </div>
    </section>

    <section aria-labelledby="cards" class="flex flex-col gap-3">
      <h2 id="cards" class="text-title-lg m-0">
        Card
      </h2>
      <Card title="Deductible" headingLevel={3}>
        The amount you pay before your insurance starts paying.
        <Fragment slot="actions">
          <Button variant="primary">Read more</Button>
        </Fragment>
      </Card>
    </section>

    <section aria-labelledby="diagrams" class="flex flex-col gap-6">
      <h2 id="diagrams" class="text-title-lg m-0">
        Diagrams
      </h2>
      {diagrams.map((d) => (
        <div class="pd-card">
          <TermVisual diagram={d.diagram} caption={d.caption} />
        </div>
      ))}
    </section>

    <section aria-labelledby="icons" class="flex flex-col gap-3">
      <h2 id="icons" class="text-title-lg m-0">
        Icons
      </h2>
      <ul class="m-0 flex list-none flex-wrap gap-4 p-0">
        {ICON_NAMES.map((name) => (
          <li class="text-label-sm flex w-24 flex-col items-center gap-1">
            <Icon name={name} />
            {name}
          </li>
        ))}
      </ul>
    </section>
  </div>
</SiteLayout>
