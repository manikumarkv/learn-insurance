---
import type { Diagram } from '../../../content/schema/term';
import Legend from './Legend.astro';

type Props = Extract<Diagram, { discriminant: 'timeline' }>['value'];
const { start, end, segments } = Astro.props;
---

<div class="flex flex-col gap-3">
  <div class="text-label flex justify-between gap-4">
    <span>{start}</span>
    <span class="text-right">{end}</span>
  </div>
  <div class="border-line-strong flex h-11 overflow-hidden rounded-md border">
    {segments.map((s, i) => (
      <div
        class:list={[`ui-fill-${s.paidBy}`, i > 0 && 'border-surface border-l-2']}
        style={`flex: ${s.share} 1 0%`}
      />
    ))}
  </div>
  <ol class="m-0 flex list-none flex-col gap-1 p-0 sm:flex-row sm:gap-6">
    {segments.map((s) => (
      <li class="flex items-center gap-2">
        <span class={`ui-swatch ui-fill-${s.paidBy}`} />
        <span class="text-body-sm">{s.label}</span>
      </li>
    ))}
  </ol>
  <Legend paidBy={segments.map((s) => s.paidBy)} />
</div>
