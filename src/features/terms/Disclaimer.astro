---
/**
 * The one disclaimer used everywhere (story 5.3). Its text is the Keystatic "Disclaimer" page,
 * so it can be edited without code.
 * - box: a bordered note on term and type pages
 * - footer: plain text in the site footer
 */
import { Icon } from '../../components/ui/Icon';
import { readPage } from '../pages/read';

interface Props {
  variant?: 'box' | 'footer';
}

const { variant = 'box' } = Astro.props;
const { html } = await readPage('disclaimer');
---

{variant === 'box' ? (
  <aside
    class="border-line bg-surface-sunken flex gap-3 rounded-md border p-4"
    aria-label="Disclaimer"
    data-testid="disclaimer"
  >
    <Icon name="info" />
    <div class="text-body-sm [&_p]:m-0" set:html={html} />
  </aside>
) : (
  <div
    class="text-body-sm text-ink-muted max-w-prose [&_p]:m-0"
    data-testid="disclaimer"
    set:html={html}
  />
)}
