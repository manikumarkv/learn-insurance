---
import AccountMenu from '../../features/account/AccountMenu.astro';
import { ThemeToggle } from '../ThemeToggle';
import { Icon } from '../ui/Icon';
import SearchForm from './SearchForm.astro';
import { isActive, MAIN_NAV } from './nav';

const { pathname } = Astro.url;
---

<header class="border-line bg-surface border-b">
  <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3">
    <a href="/" class="text-title-md text-ink flex items-center gap-2 no-underline">
      <span
        class="bg-primary text-on-primary inline-flex size-7 items-center justify-center rounded-lg text-[15px] font-extrabold"
        aria-hidden="true"
      >
        L
      </span>
      LearnInsurance
    </a>

    <!-- Desktop (1024px and up). Narrower screens use the menu below. -->
    <nav aria-label="Main" class="hidden flex-1 lg:block">
      <ul class="m-0 flex list-none gap-6 p-0">
        {MAIN_NAV.map((item) => {
          const active = isActive(pathname, item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'text-label-lg whitespace-nowrap',
                  active ? 'text-primary-ink underline' : 'text-ink no-underline hover:underline',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="hidden items-center gap-3 lg:flex">
      <div class="hidden w-56 xl:block">
        <SearchForm id="header-search" landmark="Site search" />
      </div>
      <a href="/search" class="ui-btn ui-btn-secondary ui-btn-icon xl:hidden" aria-label="Search">
        <Icon name="search" size={20} />
      </a>
      <div class="w-44">
        <ThemeToggle compact client:only="react" />
      </div>
      <AccountMenu />
    </div>

    <!-- Below 1024px: a disclosure menu that works without JavaScript. -->
    <details class="group ml-auto lg:hidden">
      <summary
        class="ui-btn ui-btn-secondary list-none [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <Icon name="menu" size={20} />
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <div class="bg-surface border-line absolute inset-x-0 z-10 mt-3 flex flex-col gap-4 border-b px-4 pb-6 shadow-md">
        <SearchForm id="menu-search" showLabel landmark="Site search" />
        <nav aria-label="Main">
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {MAIN_NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(pathname, item.href) ? 'page' : undefined}
                  class="text-label-lg"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <ThemeToggle client:only="react" />
        <AccountMenu wide />
      </div>
    </details>
  </div>
</header>
