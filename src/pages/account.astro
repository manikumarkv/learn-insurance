---
import { UserProfile } from '@clerk/astro/components';
import { AccountSettings } from '../features/account/AccountSettings';
import SiteLayout from '../layouts/SiteLayout.astro';

// Rendered on request so src/middleware.ts can send signed-out visitors to /sign-in.
export const prerender = false;
---

<SiteLayout
  title="Your account · LearnInsurance"
  description="Your LearnInsurance account."
  noindex
>
  <div class="flex flex-col gap-6">
    <h1 class="text-headline m-0">Your account</h1>
    <AccountSettings client:only="react" />
    <section aria-labelledby="profile-heading" class="flex flex-col gap-3">
      <h2 id="profile-heading" class="text-title-md m-0">
        Profile and sign-in
      </h2>
      <UserProfile routing="hash" />
    </section>
  </div>
</SiteLayout>
