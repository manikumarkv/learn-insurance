---
import { Icon } from '../ui/Icon';

interface Props {
  /** Must be unique on the page, because the header and the mobile menu both have a search form. */
  id: string;
  placeholder?: string;
  /** Show the label visibly instead of only to screen readers. */
  showLabel?: boolean;
}

const { id, placeholder = 'Search terms', showLabel = false } = Astro.props;
---

<!-- TODO(story 4.2): /search shows results. Until then the form submits to a page that doesn't exist yet. -->
<form action="/search" method="get" role="search" class="flex items-end gap-2">
  <div class="pd-field min-w-0 flex-1">
    <label for={id} class={showLabel ? 'pd-label' : 'sr-only'}>
      Search terms
    </label>
    <input
      id={id}
      class="pd-input pd-input-sm w-full"
      type="search"
      name="q"
      placeholder={placeholder}
      autocomplete="off"
    />
  </div>
  <button type="submit" class="pd-btn pd-btn-secondary pd-btn-icon" aria-label="Search">
    <Icon name="search" size={20} />
  </button>
</form>
